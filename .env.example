# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Required for the contact form to actually send email (src/app/contact/actions.ts).
# Sign up at https://resend.com, verify a sending domain there (recommended)
# or use their shared onboarding.resend.dev domain for now, then create an
# API key and paste it here. Without this set, the form will show a friendly
# error asking the visitor to call/text instead, it will not silently fail.
RESEND_API_KEY=your_api_key_here

# Optional overrides, default to values in src/data/business.ts if unset.
# CONTACT_FORM_TO_EMAIL=brco.chi@gmail.com
# CONTACT_FORM_FROM_EMAIL=onboarding@resend.dev
